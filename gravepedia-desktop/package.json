{
  "name": "gravepedia-desktop",
  "productName": "Gravepedia",
  "version": "0.0.1",
  "description": "Gravepedia desktop app (Electron Forge scaffold)",
  "main": "src/main.js",
  "scripts": {
    "start": "electron-forge start",
    "package": "electron-forge package",
    "make": "electron-forge make",
    "publish": "electron-forge publish"
  },
  "keywords": [],
  "author": "",
  "license": "MIT",
  "config": {
    "forge": {
      "packagerConfig": {},
      "makers": [
        { "name": "@electron-forge/maker-squirrel", "platforms": ["win32"] },
        { "name": "@electron-forge/maker-zip", "platforms": ["darwin"] },
        { "name": "@electron-forge/maker-deb", "platforms": ["linux"] },
        { "name": "@electron-forge/maker-rpm", "platforms": ["linux"] }
      ]
    }
  },
  "devDependencies": {
    "@electron-forge/cli": "^6.0.0",
    "@electron-forge/maker-deb": "^6.0.0",
    "@electron-forge/maker-rpm": "^6.0.0",
    "@electron-forge/maker-squirrel": "^6.0.0",
    "@electron-forge/maker-zip": "^6.0.0"
  },
  "dependencies": {}
}
